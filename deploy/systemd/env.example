# Copy to /etc/vectorstep/vectorstep-gateway/env (mode 640, owner root:vectorstep) — see install.md.
# These feed the ${VAR} placeholders in /etc/vectorstep/vectorstep-gateway/config.yaml
# (see ../../samples/config.yaml.example for where each is used).

# LLM providers — configure at least one:
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=

# MCP server env — only the ones your configured mcp_servers actually need, e.g.:
# GRAFANA_URL=
# GRAFANA_TOKEN=
# ATLASSIAN_URL=
# ATLASSIAN_API_TOKEN=
# ATLASSIAN_USERNAME=
# TAVILY_API_KEY=
