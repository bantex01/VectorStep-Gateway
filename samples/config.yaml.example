server:
  host: 0.0.0.0
  port: 18780           # Different from OpenClaw (18789) to avoid collision when both run on same machine

agents_dir: ./agents    # directory containing agent subdirectories (gitignored — see templates/agents/)

identity:
  path: ~/.pork-gateway/identity   # auto-generated on first run if absent

# Runtime limits — tune these for your environment
limits:
  max_agent_iterations: 20         # max LLM ↔ tool call loops per agent run
  request_timeout_seconds: 180     # how long to wait for a single LLM API response
  mcp_tool_timeout_seconds: 30     # per-tool-call timeout against MCP servers

# MCP tool servers — each is spawned as a subprocess on gateway startup.
# Remove servers you don't need. All env values support ${VAR_NAME} resolution.
mcp_servers:
  filesystem:
    command: npx
    args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]

  # grafana:
  #   command: npx
  #   args: ["-y", "@grafana/mcp-grafana"]
  #   env:
  #     GRAFANA_URL: ${GRAFANA_URL}
  #     GRAFANA_TOKEN: ${GRAFANA_TOKEN}

  # atlassian:
  #   command: npx
  #   args: ["-y", "@atlassian/mcp-atlassian"]
  #   env:
  #     ATLASSIAN_URL: ${ATLASSIAN_URL}
  #     ATLASSIAN_API_TOKEN: ${ATLASSIAN_API_TOKEN}
  #     ATLASSIAN_USERNAME: ${ATLASSIAN_USERNAME}

  # tavily:
  #   command: npx
  #   args: ["-y", "tavily-mcp"]
  #   env:
  #     TAVILY_API_KEY: ${TAVILY_API_KEY}

# LLM providers — configure at least one.
# Only providers with an api_key (or no auth required) will work.
# Keys under `providers:` become model prefixes for routing (see Model Routing in README).
providers:
  anthropic:
    api_key: ${ANTHROPIC_API_KEY}

  # openrouter:
  #   api_key: ${OPENROUTER_API_KEY}
  #   base_url: https://openrouter.ai/api/v1

  # ollama-local:                        # local Ollama instance — no API key needed
  #   base_url: http://localhost:11434/v1

  # ollama-cloud:                        # Ollama cloud — get key at https://ollama.com/settings/keys
  #   api_key: ${OLLAMA_API_KEY}
  #   base_url: https://ollama.com/api   # /chat appended automatically

  # google:
  #   api_key: ${GOOGLE_API_KEY}
  #   base_url: https://generativelanguage.googleapis.com/v1beta/openai

logging:
  level: INFO     # DEBUG | INFO | WARNING | ERROR
