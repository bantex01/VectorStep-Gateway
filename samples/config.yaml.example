server:
  host: 0.0.0.0
  port: 18780           # Different from OpenClaw (18789) to avoid collision when both run on same machine

agents_dir: ./agents    # directory containing agent subdirectories (gitignored — see templates/agents/)

identity:
  path: ~/.vectorstep-gateway/identity   # auto-generated on first run if absent

# Runtime limits — tune these for your environment
limits:
  max_agent_iterations: 20         # max LLM ↔ tool call loops per agent run
  request_timeout_seconds: 180     # how long to wait for a single LLM API response
  mcp_tool_timeout_seconds: 30     # per-tool-call timeout against MCP servers
  llm_retry_attempts: 2            # retries on the same model before falling over to model_fallbacks
  llm_retry_base_delay_seconds: 1.0  # exponential backoff base delay between retries
  max_concurrent_runs: 10          # gateway-wide cap on simultaneously executing agent runs
  trace_tool_result_max_chars: 3000  # gateway-wide default cap on a tool_result's TRACE copy
                                      # (observability/downstream judges only — the LLM
                                      # conversation itself always gets the full, untruncated
                                      # result regardless of this setting). A caller can
                                      # override this per-request via traceToolResultMax.

# MCP tool servers — each is spawned as a subprocess on gateway startup.
# Remove servers you don't need. All env values support ${VAR_NAME} resolution.
mcp_servers:
  filesystem:
    command: npx
    args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]

  # grafana:
  #   command: npx
  #   args: ["-y", "@grafana/mcp-grafana"]
  #   env:
  #     GRAFANA_URL: ${GRAFANA_URL}
  #     GRAFANA_TOKEN: ${GRAFANA_TOKEN}

  # atlassian:
  #   command: npx
  #   args: ["-y", "@atlassian/mcp-atlassian"]
  #   env:
  #     ATLASSIAN_URL: ${ATLASSIAN_URL}
  #     ATLASSIAN_API_TOKEN: ${ATLASSIAN_API_TOKEN}
  #     ATLASSIAN_USERNAME: ${ATLASSIAN_USERNAME}

  # tavily:
  #   command: npx
  #   args: ["-y", "tavily-mcp"]
  #   env:
  #     TAVILY_API_KEY: ${TAVILY_API_KEY}

# LLM providers — configure at least one.
# Only providers with an api_key (or no auth required) will work.
# Keys under `providers:` become model prefixes for routing (see Model Routing in README).
providers:
  anthropic:
    api_key: ${ANTHROPIC_API_KEY}

  # openrouter:
  #   api_key: ${OPENROUTER_API_KEY}
  #   base_url: https://openrouter.ai/api/v1

  # ollama-local:                        # local Ollama instance — no API key needed
  #   base_url: http://localhost:11434/v1

  # ollama-cloud:                        # Ollama cloud — get key at https://ollama.com/settings/keys
  #   api_key: ${OLLAMA_API_KEY}
  #   base_url: https://ollama.com/api   # /chat appended automatically

  # google:
  #   api_key: ${GOOGLE_API_KEY}
  #   base_url: https://generativelanguage.googleapis.com/v1beta/openai

  # azure:                                     # Azure OpenAI — model prefix: azure/<deployment-name>
  #   api_key: ${AZURE_OPENAI_API_KEY}
  #   resource_name: ${AZURE_OPENAI_RESOURCE}  # e.g. "my-company-openai" → my-company-openai.openai.azure.com
  #   api_version: "2025-01-01-preview"        # optional — this is the default
  #   # <deployment-name> is whatever you named the deployment in Azure AI Foundry, not
  #   # the underlying model family. For reasoning-family deployments (gpt-5, o1, o3),
  #   # set the agent's max_tokens generously (2000+) — see README §Azure OpenAI.

  # openai:                               # OpenAI's own API — model prefix: openai/<model>
  #   api_key: ${OPENAI_API_KEY}
  #   base_url: https://api.openai.com/v1  # optional — this is the default
  #   # For reasoning-family models (gpt-5, o1, o3), set the agent's max_tokens
  #   # generously (2000+) — see README §Providers.

  # yolo:                                # any custom OpenAI-compatible endpoint — model prefix: yolo/<model>
  #   api_key: ${YOLO_API_KEY}
  #   base_url: https://your-provider.example.com/v1

logging:
  level: INFO     # DEBUG | INFO | WARNING | ERROR
  dir: ./logs     # omit to disable file logging (stdout only)
                  # creates gateway.log and access.log (rotating, 10 MB x 5)
